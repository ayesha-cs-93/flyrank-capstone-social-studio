# Real free publish target: Telegram Bot API.
# Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN.
# Create/use a channel or chat, add the bot as admin, get TELEGRAM_CHAT_ID
# (e.g. via https://api.telegram.org/bot<token>/getUpdates after messaging the bot).
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
TELEGRAM_CHAT_ID=-1001234567890
